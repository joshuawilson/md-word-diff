{
  "name": "md-word-diff",
  "displayName": "Markdown Word Diff",
  "description": "Word-level redline diff of markdown files against git revisions.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/diff": "^5.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "diff": "5.2.0",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-frontmatter": "^2.0.0",
    "mdast-util-gfm": "^3.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "local"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "mdWordDiff.compareWithRevision",
        "title": "Compare with Revision\u2026",
        "category": "Markdown Word Diff"
      },
      {
        "command": "mdWordDiff.compareTwoRevisions",
        "title": "Compare Two Revisions\u2026",
        "category": "Markdown Word Diff"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mdWordDiff.compareWithRevision",
          "when": "resourceLangId == markdown",
          "group": "3_compare"
        },
        {
          "command": "mdWordDiff.compareTwoRevisions",
          "when": "resourceLangId == markdown",
          "group": "3_compare"
        }
      ],
      "editor/context": [
        {
          "command": "mdWordDiff.compareWithRevision",
          "when": "resourceLangId == markdown",
          "group": "3_compare"
        },
        {
          "command": "mdWordDiff.compareTwoRevisions",
          "when": "resourceLangId == markdown",
          "group": "3_compare"
        }
      ],
      "editor/title/context": [
        {
          "command": "mdWordDiff.compareWithRevision",
          "when": "resourceLangId == markdown",
          "group": "3_compare"
        },
        {
          "command": "mdWordDiff.compareTwoRevisions",
          "when": "resourceLangId == markdown",
          "group": "3_compare"
        }
      ],
      "commandPalette": [
        {
          "command": "mdWordDiff.compareWithRevision",
          "when": "editorLangId == markdown || resourceLangId == markdown"
        },
        {
          "command": "mdWordDiff.compareTwoRevisions",
          "when": "editorLangId == markdown || resourceLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Word Diff",
      "properties": {
        "mdWordDiff.pairingThreshold": {
          "type": "number",
          "default": 0.35,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "How similar an old and a new block must be (share of words in common, 0\u20131) to be shown as an **edit** with word-level marks rather than a whole deletion plus insertion. Lower = heavy rewrites still shown word by word; too low (< 0.2) pairs unrelated paragraphs. The toolbar **Pairing** control overrides this per panel (Loose = 0.2, Normal = this value, Strict = 0.6)."
        }
      }
    }
  }
}
